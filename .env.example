# Copy this file to .env and fill in the real values.
# Get these from your Supabase project: Settings -> API
# NEVER commit the real .env file - it's in .gitignore for a reason.

SUPABASE_PROJECT_ID=
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# Client-side (Vite) copies - same values, VITE_ prefix required to reach the browser bundle
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=

# Server-only - NEVER prefix this with VITE_, NEVER expose to the client.
# Bypasses Row Level Security. Only used in src/integrations/supabase/client.server.ts
SUPABASE_SERVICE_ROLE_KEY=
